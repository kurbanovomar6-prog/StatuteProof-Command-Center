# StatuteProof log rotation — install to /etc/logrotate.d/statuteproof
#
# Services log to journald (capped via SystemMaxUse in DEPLOY.md). This file
# covers the app's own rotating file logs as a second safety net — the
# 438MB-telegram-log incident must never repeat.

/srv/regradar/logs/*.log {
    daily
    rotate 14
    maxsize 50M
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su regradar regradar
}
