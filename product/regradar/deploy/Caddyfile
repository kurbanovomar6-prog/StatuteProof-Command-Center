# StatuteProof — Caddy reverse proxy (auto-TLS via Let's Encrypt).
# Install to /etc/caddy/Caddyfile and reload: systemctl reload caddy
#
# DNS prerequisites: A records for statuteproof.com and www.statuteproof.com
# pointing at this droplet. Caddy obtains and renews certificates itself.

www.statuteproof.com {
	redir https://statuteproof.com{uri} permanent
}

statuteproof.com {
	encode gzip zstd

	# API — proxied to the localhost-bound Python server.
	# Health endpoint is routed through the same path (/api/health).
	handle /api/* {
		reverse_proxy 127.0.0.1:5001 {
			# Rate-limit trust boundary: strip any client-supplied X-Real-IP
			# then set it to the real peer address Caddy sees. The backend's
			# _client_ip() trusts ONLY this header, so a client cannot spoof
			# its rate-limit key. {remote_host} is the immediate TCP peer.
			header_up -X-Real-IP
			header_up X-Real-IP {remote_host}
		}
	}

	# Frontend — static SPA build.
	handle {
		root * /srv/regradar/web/dist
		try_files {path} /index.html
		file_server

		# CSP scoped to the SPA only — the /api/* backend sets its own stricter
		# CSP (default-src 'none'), so this must not leak into that handle block.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log {
		output file /var/log/caddy/statuteproof.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
}
