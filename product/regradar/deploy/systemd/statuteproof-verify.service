[Unit]
Description=StatuteProof evidence-trail integrity verify (re-hash snapshots + tamper-evident chain; page founder on divergence)
After=network-online.target

[Service]
Type=oneshot
User=regradar
Group=regradar
WorkingDirectory=/srv/regradar
EnvironmentFile=/srv/regradar/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/regradar/.venv/bin/python run.py verify-trail-watch
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/regradar
StandardOutput=journal
StandardError=journal
