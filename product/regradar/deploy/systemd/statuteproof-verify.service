[Unit]
Description=StatuteProof evidence-trail integrity verify (re-hash snapshots + tamper-evident chain; page founder on divergence)
After=network-online.target

[Service]
Type=oneshot
User=regradar
Group=regradar
WorkingDirectory=/srv/regradar
EnvironmentFile=/srv/regradar/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/regradar/.venv/bin/python run.py verify-trail-watch
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/regradar
StandardOutput=journal
StandardError=journal
# Exit 1 (evidence-trail divergence) is an expected post-page signal, not a
# service fault — the founder has already been alerted via Telegram inside
# run.py verify-trail-watch. Treat it as clean so the timer keeps firing
# instead of the unit going into failed state (mirrors the heartbeat unit).
SuccessExitStatus=0 1
