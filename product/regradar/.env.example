# StatuteProof — environment variable template
# Copy to .env and fill in real values. Never commit .env to git.
#
# Generate a secure SECRET_KEY before first run:
#   python3 run.py generate-secret-key
#
# Validate your config at any time:
#   python3 run.py validate-config

# === Auth & Security ===

SECRET_KEY=change-me-to-a-random-64-char-string  # REQUIRED — run: python3 run.py generate-secret-key
ENVIRONMENT=production                             # REQUIRED — development | production

# === App & Server ===

PORT=5001                    # OPTIONAL — default 5001
LOG_LEVEL=WARNING            # OPTIONAL — DEBUG | INFO | WARNING | ERROR
LOG_DIR=logs                 # OPTIONAL

# === Auto-Monitoring Scheduler ===
#
# The API server launches a background monitoring thread automatically.
# Set to 0 to disable (useful for local dev when you run scans manually).
#
AUTO_MONITOR_INTERVAL=60     # OPTIONAL — minutes between full scan cycles (default: 60)

# === Google OAuth (for "Continue with Google" on login/register) ===
#
# Setup: console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID
#   Application type: Web application
#   Authorised redirect URI: https://statuteproof.com/api/auth/google/callback
#
GOOGLE_OAUTH_CLIENT_ID=       # REQUIRED for Google sign-in (from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_SECRET=   # REQUIRED for Google sign-in (from Google Cloud Console)
GOOGLE_OAUTH_REDIRECT_URI=https://statuteproof.com/api/auth/google/callback  # REQUIRED

# === Database ===

REGRADAR_DB_PATH=data/statuteproof.db  # REQUIRED — path to SQLite database file

# === Telegram ===
#
# Two separate bots. Do NOT mix their tokens.
#
# Bot 1: Admin/founder bot — contact-form notifications only, never shown to customers.
TELEGRAM_BOT_TOKEN=        # REQUIRED if using contact-form Telegram delivery
TELEGRAM_CHAT_ID=          # REQUIRED if using contact-form Telegram delivery
TELEGRAM_BOT_USERNAME=StatuteProof_bot  # OPTIONAL

# Bot 2: Customer alerts bot — public, shown on website.
TELEGRAM_ALERTS_BOT_TOKEN=              # REQUIRED for customer alert delivery
TELEGRAM_ALERTS_BOT_USERNAME=statuteproofalerts_bot  # OPTIONAL
ENABLE_TELEGRAM_ALERTS=false            # OPTIONAL — set true to send MEDIUM/HIGH alerts

# === AI (optional) ===

ENABLE_AI_ANALYSIS=false                # OPTIONAL — set true to enable Claude AI analysis
ANTHROPIC_API_KEY=                      # OPTIONAL — required when ENABLE_AI_ANALYSIS=true
AI_MIN_RISK_FOR_ANALYSIS=MEDIUM         # OPTIONAL — LOW | MEDIUM | HIGH
AI_MAX_CALLS_PER_RUN=3                  # OPTIONAL — max Claude API calls per batch run
AI_OUTPUT_LANGUAGE=en                   # OPTIONAL — language code for AI pipeline summaries
AI_BRIEF_LANGUAGE=en                    # OPTIONAL — language code for AI brief output
AI_DETECT_LANGUAGE=true                 # OPTIONAL — detect source language before AI call

OPENAI_API_KEY=                         # OPTIONAL — if using OpenAI-based features

# === Stripe (optional) ===
#
# Connect Stripe when audit binder export and automated billing are ready.
# Create products in Stripe dashboard, copy price IDs here.
STRIPE_SECRET_KEY=sk_live_...           # OPTIONAL
STRIPE_PUBLISHABLE_KEY=pk_live_...      # OPTIONAL
STRIPE_PRICE_STARTER=price_...          # OPTIONAL — $199/month Founding Pilot
STRIPE_PRICE_PROFESSIONAL=price_...     # OPTIONAL — $399/month UAE Monitor
STRIPE_WEBHOOK_SECRET=whsec_...         # OPTIONAL

# === Scraper timeouts ===

REGRADAR_TIMEOUT_MS=30000      # OPTIONAL — Playwright page-load timeout in ms
REGRADAR_HTTP_TIMEOUT_S=15     # OPTIONAL — requests.get() timeout in seconds

# === Scheduler ===

WATCH_INTERVAL_MINUTES=60      # OPTIONAL — watch mode re-check interval in minutes

# === Source discovery ===

DISCOVERY_MAX_LINKS=50                  # OPTIONAL
DISCOVERY_MAX_SAMPLE_DOCS=3             # OPTIONAL
DOCUMENT_MAX_DOWNLOAD_MB=15             # OPTIONAL
ENABLE_DEEP_SOURCE_DISCOVERY=false      # OPTIONAL
ENABLE_CRAWL4AI_EXTRACTOR=false         # OPTIONAL — experimental headless extractor

# === Email delivery (monitoring briefs) ===
# Provider selection. Default local_outbox writes JSON payloads to
# data/outbox/ and NEVER sends externally — safe for pilots and dev.
# A selected provider with missing keys FAILS LOUDLY (no outbox fallback);
# every delivery attempt is recorded in data/email_outbox/delivery_status.jsonl.

STATUTEPROOF_EMAIL_PROVIDER=local_outbox   # local_outbox | smtp | postmark | sendgrid
STATUTEPROOF_EMAIL_FROM=                   # REQUIRED for any non-outbox provider
STATUTEPROOF_EMAIL_REPLY_TO=               # OPTIONAL
STATUTEPROOF_EMAIL_SENDER_NAME=StatuteProof Monitoring  # OPTIONAL
STATUTEPROOF_EMAIL_SEND_ENABLED=false      # Must be explicitly true before ANY external email is sent
STATUTEPROOF_EMAIL_DRY_RUN=false           # true = full provider path, zero network I/O (prod smoke test)

# SMTP provider (STATUTEPROOF_EMAIL_PROVIDER=smtp)
SMTP_HOST=                     # OPTIONAL
SMTP_PORT=465                  # OPTIONAL — SMTP_SSL port
SMTP_USERNAME=                 # OPTIONAL
SMTP_PASSWORD=                 # OPTIONAL

# API providers
POSTMARK_SERVER_TOKEN=         # REQUIRED for postmark provider
SENDGRID_API_KEY=              # REQUIRED for sendgrid provider

# Legacy contact-form email fields (kept for compatibility)
SMTP_USER=                     # OPTIONAL — legacy alias, prefer SMTP_USERNAME
BRIEF_FROM_EMAIL=briefs@statuteproof.com  # OPTIONAL

# === Paths & deployment ===

STATUTEPROOF_BASE_DIR=         # OPTIONAL — artifact base dir (data/, snapshots). Default: app root
REGRADAR_DB_PATH=              # OPTIONAL — SQLite path. Default: <app root>/regradar.db
CORS_ALLOWED_ORIGIN=           # OPTIONAL — comma-separated origin allowlist, e.g.
                               #   https://statuteproof.com,https://www.statuteproof.com
                               # Leave EMPTY for same-origin production behind the reverse proxy.
# VITE_API_URL is a FRONTEND BUILD-TIME variable (cd web && VITE_API_URL=... npm run build).
# Leave unset for same-origin deployments. Must never point at localhost in a prod build —
# deploy/deploy-check.sh enforces this.

# === Misc ===

REGRADAR_CONTACT_DELIVERY_DISABLED=false  # OPTIONAL — set true in smoke tests
