# StatuteProof — environment variable template
# Copy to .env and fill in real values. Never commit .env to git.
#
# Generate a secure SECRET_KEY before first run:
#   python3 run.py generate-secret-key
#
# Validate your config at any time:
#   python3 run.py validate-config

# === Auth & Security ===

SECRET_KEY=change-me-to-a-random-64-char-string  # REQUIRED — run: python3 run.py generate-secret-key
ENVIRONMENT=production                             # REQUIRED — development | production

# === App & Server ===

PORT=5001                    # OPTIONAL — default 5001
LOG_LEVEL=WARNING            # OPTIONAL — DEBUG | INFO | WARNING | ERROR
LOG_DIR=logs                 # OPTIONAL

# === Monitoring scheduler ===
#
# The API server performs NO monitoring sweeps. Scheduling is a separate
# process: `python run.py watch --interval 60` (systemd: statuteproof-scheduler).

# === Google OAuth (for "Continue with Google" on login/register) ===
#
# Setup: console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID
#   Application type: Web application
#   Authorised redirect URI: https://statuteproof.com/api/auth/google/callback
#
# REQUIRED for Google sign-in (from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=
# REQUIRED for Google sign-in (from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://statuteproof.com/api/auth/google/callback  # REQUIRED

# === Database ===

REGRADAR_DB_PATH=data/statuteproof.db  # REQUIRED — path to SQLite database file

# === Telegram ===
#
# Two separate bots. Do NOT mix their tokens.
#
# Bot 1: Admin/founder bot — contact-form notifications only, never shown to customers.
# REQUIRED if using contact-form Telegram delivery
TELEGRAM_BOT_TOKEN=
# REQUIRED if using contact-form Telegram delivery
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=StatuteProof_bot  # OPTIONAL

# Bot 2: Customer alerts bot — public, shown on website.
# REQUIRED for customer alert delivery
TELEGRAM_ALERTS_BOT_TOKEN=
TELEGRAM_ALERTS_BOT_USERNAME=statuteproofalerts_bot  # OPTIONAL
ENABLE_TELEGRAM_ALERTS=false            # OPTIONAL — set true to send MEDIUM/HIGH alerts

# === AI (optional) ===

ENABLE_AI_ANALYSIS=false                # OPTIONAL — set true to enable Claude AI analysis
# OPTIONAL — required when ENABLE_AI_ANALYSIS=true
ANTHROPIC_API_KEY=
AI_MIN_RISK_FOR_ANALYSIS=MEDIUM         # OPTIONAL — LOW | MEDIUM | HIGH
AI_MAX_CALLS_PER_RUN=3                  # OPTIONAL — max Claude API calls per batch run
AI_OUTPUT_LANGUAGE=en                   # OPTIONAL — language code for AI pipeline summaries
AI_BRIEF_LANGUAGE=en                    # OPTIONAL — language code for AI brief output
AI_DETECT_LANGUAGE=true                 # OPTIONAL — detect source language before AI call

# OPTIONAL — if using OpenAI-based features
OPENAI_API_KEY=

# === Stripe (optional) ===
#
# Connect Stripe when audit binder export and automated billing are ready.
# Create products in Stripe dashboard, copy price IDs here.
STRIPE_SECRET_KEY=sk_live_...           # OPTIONAL
STRIPE_PUBLISHABLE_KEY=pk_live_...      # OPTIONAL
STRIPE_PRICE_STARTER=price_...          # OPTIONAL — $199/month Founding Pilot
STRIPE_PRICE_PROFESSIONAL=price_...     # OPTIONAL — $399/month UAE Monitor
#
# --- Payment → plan automation (POST /api/stripe/webhook) --------------------
# The webhook turns a VERIFIED Stripe payment into the SAME plan activation the
# founder admin panel performs. It is inert until BOTH values below are set;
# with STRIPE_WEBHOOK_SECRET unset the endpoint fail-closes and rejects every
# call. OWNER FILLS THESE — no real secret or price id ships in the repo.
#
# STRIPE_WEBHOOK_SECRET: the signing secret for THIS endpoint. In the Stripe
# Dashboard → Developers → Webhooks, add an endpoint for
#   https://statuteproof.com/api/stripe/webhook
# subscribed to `checkout.session.completed` and `invoice.paid`, then copy its
# `whsec_...` Signing secret here. Unset = webhook disabled (fail-closed).
STRIPE_WEBHOOK_SECRET=whsec_...         # OPTIONAL (REQUIRED to enable the webhook)
#
# STRIPE_PRICE_TO_PLAN: map each Stripe Price id to a StatuteProof plan name,
# comma-separated `price_id:plan_name`. Plan names: evidence_preview,
# starter_pilot, professional, consultant. Example (fill with YOUR real ids):
#   STRIPE_PRICE_TO_PLAN=price_ABC:starter_pilot,price_DEF:professional
# An unmapped price is acknowledged but activates nothing.
STRIPE_PRICE_TO_PLAN=                    # OPTIONAL (REQUIRED to enable the webhook)
#
# GO-LIVE (owner):
#   1. Set STRIPE_WEBHOOK_SECRET and STRIPE_PRICE_TO_PLAN (real values) and
#      restart the API.
#   2. When creating the Checkout Session / Payment Link, set
#      `client_reference_id` to the StatuteProof user id so the payment binds to
#      the right account (fallback: a VERIFIED customer_email match).
#   3. Paste the real Payment Links into
#      web/src/data/constants.js (STRIPE_LINK_FOUNDING_PILOT / _UAE_MONITOR),
#      which are empty placeholders today, and rebuild the web bundle.

# === Scraper timeouts ===

REGRADAR_TIMEOUT_MS=30000      # OPTIONAL — Playwright page-load timeout in ms
REGRADAR_HTTP_TIMEOUT_S=15     # OPTIONAL — requests.get() timeout in seconds

# === Scheduler ===

WATCH_INTERVAL_MINUTES=60      # OPTIONAL — watch mode re-check interval in minutes

# === Source discovery ===

DISCOVERY_MAX_LINKS=50                  # OPTIONAL
DISCOVERY_MAX_SAMPLE_DOCS=3             # OPTIONAL
DOCUMENT_MAX_DOWNLOAD_MB=15             # OPTIONAL
ENABLE_DEEP_SOURCE_DISCOVERY=false      # OPTIONAL
ENABLE_CRAWL4AI_EXTRACTOR=false         # OPTIONAL — experimental headless extractor

# === Email delivery (monitoring briefs) ===
# Provider selection. Default local_outbox writes JSON payloads to
# data/outbox/ and NEVER sends externally — safe for pilots and dev.
# A selected provider with missing keys FAILS LOUDLY (no outbox fallback);
# every delivery attempt is recorded in data/email_outbox/delivery_status.jsonl.

STATUTEPROOF_EMAIL_PROVIDER=local_outbox   # local_outbox | smtp | postmark | sendgrid
# REQUIRED for any non-outbox provider
STATUTEPROOF_EMAIL_FROM=
# OPTIONAL
STATUTEPROOF_EMAIL_REPLY_TO=
STATUTEPROOF_EMAIL_SENDER_NAME=StatuteProof Monitoring  # OPTIONAL
STATUTEPROOF_EMAIL_SEND_ENABLED=false      # Must be explicitly true before ANY external email is sent
STATUTEPROOF_EMAIL_DRY_RUN=false           # true = full provider path, zero network I/O (prod smoke test)

# SMTP provider (STATUTEPROOF_EMAIL_PROVIDER=smtp)
# OPTIONAL
SMTP_HOST=
SMTP_PORT=465                  # OPTIONAL — SMTP_SSL port
# OPTIONAL
SMTP_USERNAME=
# OPTIONAL
SMTP_PASSWORD=

# API providers
# REQUIRED for postmark provider
POSTMARK_SERVER_TOKEN=
# REQUIRED for sendgrid provider
SENDGRID_API_KEY=

# Legacy contact-form email fields (kept for compatibility)
# OPTIONAL — legacy alias, prefer SMTP_USERNAME
SMTP_USER=
BRIEF_FROM_EMAIL=briefs@statuteproof.com  # OPTIONAL

# === Paths & deployment ===

# OPTIONAL — artifact base dir (data/, snapshots). Default: app root
STATUTEPROOF_BASE_DIR=
# (REGRADAR_DB_PATH lives in the Database section above.)
# OPTIONAL — comma-separated origin allowlist, e.g.
#   https://statuteproof.com,https://www.statuteproof.com
# Leave EMPTY for same-origin production behind the reverse proxy.
CORS_ALLOWED_ORIGIN=
# VITE_API_URL is a FRONTEND BUILD-TIME variable (cd web && VITE_API_URL=... npm run build).
# Leave unset for same-origin deployments. Must never point at localhost in a prod build —
# deploy/deploy-check.sh enforces this.

# === Evidence durability & provability ===

# STRONGLY RECOMMENDED in production — off-box backup target for deploy/backup.sh.
# An rclone remote (e.g. s3:bucket/path) when rclone is installed, else an scp
# target (user@host:/path). UNSET = backups are local-only and the sealed
# evidence tree does NOT survive droplet loss; backup.sh warns on every run.
STATUTEPROOF_BACKUP_REMOTE=
# DEV-ONLY override: lets deploy/deploy-check.sh pass without an off-box backup
# remote, and suppresses the founder page for local-only backups.
# It is REFUSED on a production host: deploy/deploy-check.sh FAILS on it and
# deploy/backup.sh ignores it whenever ENVIRONMENT (or STATUTEPROOF_ENV) is
# production/prod, or the app is installed at /srv/regradar. Dev machines only.
STATUTEPROOF_ALLOW_LOCAL_BACKUP_ONLY=
# REQUIRED whenever STATUTEPROOF_BACKUP_REMOTE is set — the archive contains
# regradar.db (password hashes, emails, telegram_chat_ids, and the sessions
# table whose ids are bearer credentials), so nothing leaves the droplet in the
# clear. Preferred: an age RECIPIENT (public key, `age-keygen` off-box) — the
# private key never touches the droplet. Encrypt with age, decrypt off-box.
# WARNING: if you lose the matching age IDENTITY (private key), every off-box
# archive is permanently unreadable. Store it in the founder's password manager
# and rehearse a restore (DEPLOY.md § Restore from backup).
STATUTEPROOF_BACKUP_AGE_RECIPIENT=
# Fallback when age is unavailable — passphrase for `gpg --symmetric` (AES256).
# Handed to gpg on fd 0, never on a command line and never written to disk.
# WARNING: losing this passphrase means losing every off-box archive. No
# recovery path exists — keep it in the founder's password manager only.
STATUTEPROOF_BACKUP_PASSPHRASE=
# DEV-ONLY override: push the archive off-box UNENCRYPTED.
# It is REFUSED on a production host: deploy/deploy-check.sh FAILS on it and
# deploy/backup.sh ignores it whenever ENVIRONMENT (or STATUTEPROOF_ENV) is
# production/prod, or the app is installed at /srv/regradar — it would place
# password hashes and live session ids on storage we do not control. Off
# production it downgrades the encryption gate to a warning.
STATUTEPROOF_ALLOW_UNENCRYPTED_BACKUP=
# OPTIONAL — external uptime probe (healthchecks.io / UptimeRobot heartbeat).
# run.py heartbeat-check pings this URL after each SUCCESSFUL internal check;
# the external service alerts the owner when pings stop. Owner creates the
# account + URL (DEPLOY.md § External uptime probe). UNSET = no external ping.
# STATUTEPROOF_OPS_ALERTS_DISABLED also suppresses this ping, so a non-production
# box cannot hold the external deadman green during a real production outage —
# but do not carry the production ping URL on staging/restore-drill boxes either.
STATUTEPROOF_HEARTBEAT_PING_URL=
# OPTIONAL — RFC 3161 timestamp authority URL (e.g. https://freetsa.org/tsr).
# UNSET (default) = the trusted-timestamp anchor is a complete no-op and no
# .tsr tokens are produced. Set it BEFORE selling "RFC 3161" anywhere.
RFC3161_TSA_URL=
# OPTIONAL — egress proxy for regulator hosts that 403 datacenter IPs
# (rulebook.centralbank.ae, www.dfsa.ae — see app/adapters/base.py allowlist).
# UNSET = those sources stay ACCESS_BLOCKED from the droplet.
STATUTEPROOF_FETCH_PROXY=
# OPTIONAL — gate outbound customer alerts on a paid/activated plan (default ON;
# set 0/false/no/off to restore the ungated pilot broadcast to every paired chat).
# MIGRATION WARNING: with the gate ON, currently-paired FREE accounts STOP
# receiving official-source alerts, digests, heartbeats and deadline reminders on
# the next scheduler cycle — until their plan is activated or their email is
# listed in STATUTEPROOF_ALERT_PLAN_EXEMPT_EMAILS below.
STATUTEPROOF_ALERTS_REQUIRE_PLAN=1
# OPTIONAL — comma-separated operator emails exempt from the plan gate above
# (founder/ops accounts that must keep receiving alerts without an activated
# plan). UNSET = no exemptions.
STATUTEPROOF_ALERT_PLAN_EXEMPT_EMAILS=
# REQUIRED to use the founder admin panel (GET /api/admin/accounts,
# POST /api/admin/activate-plan) — comma-separated founder/operator emails
# allowed to list accounts and activate plans from the web UI instead of the
# run.py activate-plan CLI. UNSET (default) = the admin panel is inaccessible
# to EVERYONE (fail-closed); an ordinary customer is never admin regardless.
# Losing/leaking this does not grant RBAC roles — the panel activates billing
# plans only, never owner/operator roles.
STATUTEPROOF_ADMIN_EMAILS=

# === Misc ===

REGRADAR_CONTACT_DELIVERY_DISABLED=false  # OPTIONAL — set true in smoke tests
