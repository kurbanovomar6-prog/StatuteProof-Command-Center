# StatuteProof — environment variable template
# Copy to .env and fill in real values. Never commit .env to git.

# --- App ---
SECRET_KEY=change-me-to-a-random-64-char-string
PORT=5001
DB_PATH=data/statuteproof.db

# --- Stripe (not yet wired — founding pilots are activated manually) ---
# Connect Stripe when audit binder export and automated billing are ready.
# Create products in Stripe dashboard, copy price IDs here.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_STARTER=price_...        # $199/month — Founding Pilot (starter_pilot)
STRIPE_PRICE_PROFESSIONAL=price_...  # $399/month — UAE Monitor (professional)
# STRIPE_PRICE_CONSULTANT — Consultant stays manual / Talk to us. No Stripe product yet.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Telegram brief delivery ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (optional, requires activation) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
BRIEF_FROM_EMAIL=briefs@statuteproof.com
